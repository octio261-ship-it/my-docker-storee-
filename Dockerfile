# 1. اختر بيئة العمل الأساسية (صورة خفيفة لـ Node.js)
FROM node:18-alpine

# 2. حدد مجلد العمل داخل الحاوية
WORKDIR /app

# 3. انسخ ملف الكود إلى داخل الحاوية
COPY server.js .

# 4. افتح المنفذ الذي سيعمل عليه التطبيق
EXPOSE 3000

# 5. الأمر الافتراضي لتشغيل التطبيق عند عمل الحاوية
CMD ["node", "server.js"]
